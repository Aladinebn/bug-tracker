pipeline {

    // Exécute le pipeline sur n'importe quel agent Jenkins
    agent any

    stages {

        // ============================================================
        // Exécuter les tests Backend et Frontend en parallèle
        // ============================================================
        stage('Running Unit Tests') {

            parallel {

                // ====================================================
                // BACKEND
                // ====================================================
                stage('Unit Test - Backend') {

                    agent {
                        docker {
                            image 'snakee/golang-junit:1.21'
                            reuseNode true
                        }
                    }

                    environment {
                        HOME = "${WORKSPACE}"
                        GOCACHE = "${WORKSPACE}/.cache/go-build"
                        GOPATH = "${WORKSPACE}/.cache/go-path"
                    }

                    steps {

                        dir('bugtracker-backend') {

                            sh '''
                                # Création des répertoires
                                mkdir -p "$GOCACHE"
                                mkdir -p "$GOPATH"
                                mkdir -p reports
                                mkdir -p test-results

                                echo "Running Backend Unit Tests..."

                                # Génération du rapport JUnit
                                go test -v ./... | go-junit-report > test-results/test-results.xml

                                echo "Generating Coverage..."

                                # Génération de la couverture
                                go test -coverprofile=coverage.out -covermode=atomic ./...

                                # Génération du rapport HTML
                                go tool cover -html=coverage.out -o reports/coverage.html
                            '''
                        }
                    }

                    post {

                        always {

                            junit allowEmptyResults: true,
                                  testResults: 'bugtracker-backend/test-results/test-results.xml'

                            publishHTML(target: [
                                allowMissing: true,
                                alwaysLinkToLastBuild: true,
                                keepAll: true,
                                reportDir: 'bugtracker-backend/reports',
                                reportFiles: 'coverage.html',
                                reportName: 'Backend Coverage Report'
                            ])
                        }
                    }
                }

                // ====================================================
                // FRONTEND
                // ====================================================
                stage('Unit Test - Frontend') {

                    agent {
                        docker {
                            image 'node:20-alpine'
                            reuseNode true
                        }
                    }

                    steps {

                        dir('bugtracker-frontend') {

                            sh '''
                                echo "Installing dependencies..."

                                npm ci

                                echo "Running Frontend Unit Tests..."

                                npm test
                            '''
                        }
                    }

                    post {

                        always {

                            junit allowEmptyResults: false,
                                  testResults: 'bugtracker-frontend/test-results.xml'

                            publishHTML(target: [
                                allowMissing: false,
                                alwaysLinkToLastBuild: true,
                                keepAll: true,
                                reportDir: 'bugtracker-frontend/coverage',
                                reportFiles: 'index.html',
                                reportName: 'Frontend Coverage Report'
                            ])
                        }
                    }
                }
            }
        }

        // ============================================================
        // Lancement de l'application
        // Cette étape ne s'exécute que si tous les tests réussissent
        // ============================================================
        stage('Launch Application') {

            agent {
    docker {
        image 'docker:28-cli'
        reuseNode true
        args '-v /var/run/docker.sock:/var/run/docker.sock --group-add 2375'
    }
}

            steps {

                sh '''
                    echo "========== Docker Version =========="
                    docker version

                    echo "========== Docker Compose Version =========="
                    docker compose version

                    echo "Stopping previous containers..."

                    docker compose down || true

                    echo "Starting application..."

                    docker compose up --build -d

                    echo "Application started successfully."
                '''
            }
        }
    }

    // ============================================================
    // Actions exécutées à la fin du pipeline
    // ============================================================
    post {

        always {

            cleanWs()

            echo 'Pipeline terminé.'
        }

        success {

            echo 'Tous les tests sont passés.'

            echo 'Application lancée avec succès.'
        }

        failure {

            echo 'Le pipeline a échoué.'
        }
    }
}