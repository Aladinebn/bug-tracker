pipeline {
    agent any
    stages {
        stage('Unit Test - Backend') {
            agent {
                docker { image 'snakee/golang-junit:1.21' }
                reuseNode true
            }
            environment {
                GOCACHE = "${WORKSPACE}/.cache/go-build"
                GOPATH  = "${WORKSPACE}/.cache/go-path"
                HOME    = "${WORKSPACE}"
            }
            steps {
                dir('bugtracker-backend') {
                   sh '''
                    mkdir -p "$GOCACHE"
                    mkdir -p "$GOPATH"

                    go test -v ./...
                    '''
                }
            }
        }
    
    stage('Unit Test - Frontend') {
        agent {
            docker { image 'node:20-alpine' }
            reuseNode true
        }
        steps {
            dir('bugtracker-frontend') {
                sh 'npm install'
                sh 'npm test'
            }
        }
        post {
            always {
                junit 'bugtracker-frontend/test-results.xml'
            }
    }
    }
    }
}