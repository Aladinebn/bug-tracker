pipeline {

    // Exécute le pipeline sur n'importe quel agent Jenkins disponible
    agent any

    stages {
stage('Running Unit Tests'){
    parallel {
       
   
        // ============================
        // BACKEND UNIT TESTS
        // ============================
        stage('Unit Test - Backend') {

            // Exécute ce stage dans un conteneur Docker
            agent {
                docker {
                    // Image Docker contenant Go et go-junit-report
                    image 'snakee/golang-junit:1.21'

                    // Réutilise le même workspace Jenkins
                    reuseNode true
                }
            }

            // Variables d'environnement utilisées par Go
            environment {

                // Répertoire HOME utilisé dans le conteneur
                HOME = "${WORKSPACE}"

                // Cache de compilation Go
                GOCACHE = "${WORKSPACE}/.cache/go-build"

                // Workspace Go
                GOPATH = "${WORKSPACE}/.cache/go-path"
            }

            steps {

                // Se placer dans le projet backend
                dir('bugtracker-backend') {

                    sh '''

                        # Création des dossiers nécessaires
                        mkdir -p "$GOCACHE"
                        mkdir -p "$GOPATH"
                        mkdir -p reports
                        mkdir -p test-results

                        # Exécute tous les tests unitaires
                        # Le résultat est converti au format JUnit
                        go test -v ./... 2>&1 | go-junit-report > test-results/test-results.xml

                        # Génère le fichier de couverture de code
                        go test -coverprofile=coverage.out -covermode=atomic ./...

                        # Génère un rapport HTML de couverture
                        go tool cover -html=coverage.out -o reports/coverage.html
                    '''
                }
            }

            post {

                // Toujours exécuté, même si les tests échouent
                always {

                    // Publie les résultats des tests dans Jenkins
                    junit allowEmptyResults: true,
                          testResults: 'bugtracker-backend/test-results/test-results.xml'

                    // Publie le rapport HTML de couverture
                    publishHTML(target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'bugtracker-backend/reports',
                        reportFiles: 'coverage.html',
                        reportName: 'Backend Coverage Report'
                    ])
                }
            }
        }

        // ============================
        // FRONTEND UNIT TESTS
        // ============================
        stage('Unit Test - Frontend') {

            agent {
                docker {

                    // Image Docker contenant Node.js
                    image 'node:20-alpine'

                    // Réutilise le workspace Jenkins
                    reuseNode true
                }
            }

            steps {

                // Aller dans le dossier du frontend
                dir('bugtracker-frontend') {

                    sh '''

                        # Installation des dépendances
                        npm ci

                        # Exécution des tests
                        npm test

                        # Génération du rapport de couverture
                        mkdir -p reports
                        mv coverage reports/
                    '''
                }
            }

            post {

                always {

                    // Publie les résultats JUnit
                         junit allowEmptyResults: true,
                          testResults: 'bugtracker-frontend/test-results.xml'

                    // Publie le rapport HTML
                    publishHTML(target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'bugtracker-frontend/reports/coverage',
                        reportFiles: 'index.html',
                        reportName: 'Frontend Coverage Report'
                    ])
                }
            }
        }
    }
 }
}
    // ============================
    // FIN DU PIPELINE
    // ============================
    post {

        // Toujours exécuté
        always {
            echo 'Pipeline terminé.'
        }

        // Si toutes les étapes réussissent
        success {
            echo 'Tous les tests sont passés avec succès.'
        }

        // Si une étape échoue
        failure {
            echo 'Le pipeline a échoué.'
        }
    }
}