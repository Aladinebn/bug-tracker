pipeline {

    // Exécute le pipeline sur n'importe quel agent Jenkins
    agent any

    stages {

        // ============================================================
        // Exécuter les tests Backend et Frontend en parallèle
        // ============================================================
        stage('Running Unit Tests') {

            parallel {

                // ====================================================
                // BACKEND
                // ====================================================
                stage('Unit Test - Backend') {

                    agent {
                        docker {
                            image 'snakee/golang-junit:1.21'
                            reuseNode true
                        }
                    }

                    environment {
                        // HOME pointe vers le workspace pour éviter les
                        // problèmes de permission d'écriture (l'utilisateur
                        // du conteneur n'a pas de $HOME par défaut)
                        HOME = "${WORKSPACE}"
                        GOCACHE = "${WORKSPACE}/.cache/go-build"
                        GOPATH = "${WORKSPACE}/.cache/go-path"
                    }

                    steps {

                        dir('bugtracker-backend') {

                            sh '''
                                # Création des répertoires
                                mkdir -p "$GOCACHE"
                                mkdir -p "$GOPATH"
                                mkdir -p reports
                                mkdir -p test-results

                                echo "Running Backend Unit Tests..."

                                # Génération du rapport JUnit
                                go test -v ./... | go-junit-report > test-results/test-results.xml

                                echo "Generating Coverage..."

                                # Génération de la couverture
                                go test -coverprofile=coverage.out -covermode=atomic ./...

                                # Génération du rapport HTML
                                go tool cover -html=coverage.out -o reports/coverage.html
                            '''
                        }
                    }

                    post {

                        always {

                            junit allowEmptyResults: true,
                                  testResults: 'bugtracker-backend/test-results/test-results.xml'

                            publishHTML(target: [
                                allowMissing: true,
                                alwaysLinkToLastBuild: true,
                                keepAll: true,
                                reportDir: 'bugtracker-backend/reports',
                                reportFiles: 'coverage.html',
                                reportName: 'Backend Coverage Report'
                            ])
                        }
                    }
                }

                // ====================================================
                // FRONTEND
                // ====================================================
                stage('Unit Test - Frontend') {

                    agent {
                        docker {
                            image 'node:20-alpine'
                            reuseNode true
                        }
                    }

                    steps {

                        dir('bugtracker-frontend') {

                            sh '''
                                echo "Installing dependencies..."

                                npm ci

                                echo "Running Frontend Unit Tests..."

                                npm test
                            '''
                        }
                    }

                    post {

                        always {

                            junit allowEmptyResults: false,
                                  testResults: 'bugtracker-frontend/test-results.xml'

                            publishHTML(target: [
                                allowMissing: false,
                                alwaysLinkToLastBuild: true,
                                keepAll: true,
                                reportDir: 'bugtracker-frontend/coverage',
                                reportFiles: 'index.html',
                                reportName: 'Frontend Coverage Report'
                            ])
                        }
                    }
                }
            }
        }

        // ============================================================
        // Lancement de l'application
        // Cette étape ne s'exécute que si tous les tests réussissent
        // ============================================================
        stage('Launch Application') {

            agent {
                docker {
                    image 'docker:28-cli'
                    reuseNode true

                    // -v .../docker.sock : monte le socket Docker de l'hôte
                    // pour que le conteneur docker:28-cli puisse piloter
                    // le daemon Docker de la machine hôte (Docker-in-Docker
                    // "par socket partagé")
                    //
                    // --group-add 2375 : le socket appartient au groupe
                    // "docker" (GID 2375) sur l'hôte. L'utilisateur du
                    // conteneur (UID 1000, non-root) n'a pas ce groupe par
                    // défaut -> "permission denied" sans cette option.
                    // Le GID a été trouvé avec :
                    //   docker exec -it jenkins-docker getent group docker
                    args '-v /var/run/docker.sock:/var/run/docker.sock --group-add 2375'
                }
            }
            environment {
                // HOME redéfini vers le workspace : sans ça, le client
                // Docker/Compose essaie d'écrire sa config dans "/" (le
                // HOME par défaut du conteneur), ce qui donne
                // "mkdir /.docker: permission denied"
                HOME = "${WORKSPACE}"

                // Emplacement explicite du fichier de config Docker CLI
                // (config.json), placé dans un dossier où l'utilisateur
                // a les droits d'écriture
                DOCKER_CONFIG = "${WORKSPACE}/.docker"
            }
            steps {
                sh '''
                # Créé le dossier de config Docker AVANT toute commande
                # docker/docker compose, sinon Docker tente de le créer
                # lui-même au mauvais endroit et échoue
                mkdir -p "$DOCKER_CONFIG"

                echo "========== Docker Version =========="
                docker version

                echo "========== Docker Compose Version =========="
                docker compose version

                echo "Stopping previous containers..."

                # "|| true" : ne fait pas échouer le pipeline si aucun
                # conteneur n'existait encore (premier lancement)
                docker compose down || true

                echo "Starting application..."

                docker compose up --build -d

                echo "Application started successfully."
                '''
            }
        }
        stage('API Tests') {
            agent {
                docker {
                    image 'mcr.microsoft.com/playwright:v1.50.0-jammy'
                    reuseNode true
                    args '-u 0 --network host'  // Exécuter en tant que root et utiliser le réseau de l'hôte
                }
            }
            steps {
              dir('tests-api'){
                sh '''
                npx wait-port 8080 http://localhost:8080 --timeout=30000
                echo "Running API Tests..."
                npm ci
                npx playwright test 
                '''
              }
            }
            post {
                    always {
                        junit allowEmptyResults: false,
                              testResults:'tests-api/test-results/results.xml'
                        
                        publishHTML(target: [
                            allowMissing: false,
                            alwaysLinkToLastBuild: true,
                            keepAll: true,
                            reportDir: 'tests-api/playwright-report',
                            reportFiles: 'index.html',
                            reportName: 'Playwright API Test Report'
                        ])
                        }
                    }
                }
        }
    }

    // ============================================================
    // Actions exécutées à la fin du pipeline
    // ============================================================
    post {

        always {

            cleanWs()

            echo 'Pipeline terminé.'
        }

        success {

            echo 'Tous les tests sont passés.'

            echo 'Application lancée avec succès.'
        }

        failure {

            echo 'Le pipeline a échoué.'
        }
    }
}